{
  "name": "voice-callsim",
  "version": "0.2.0-dev.1",
  "description": "Scripted caller tests for voice agents on Twilio Media Streams and LiveKit, locally and in CI.",
  "type": "module",
  "license": "MIT",
  "author": "Salman Labs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "callsim": "dist/cli.js",
    "voice-callsim": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salman-Labs/callsim.git"
  },
  "bugs": {
    "url": "https://github.com/Salman-Labs/callsim/issues"
  },
  "homepage": "https://github.com/Salman-Labs/callsim#readme",
  "keywords": [
    "callsim",
    "twilio",
    "media-streams",
    "voice-ai",
    "voice-agent",
    "realtime",
    "testing",
    "ci",
    "websocket",
    "telephony",
    "livekit",
    "barge-in",
    "dtmf",
    "scenarios"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "generate:fixtures": "tsx scripts/generate-fixtures.ts",
    "example:good": "tsx examples/good-bot.ts",
    "example:buggy": "tsx examples/buggy-bot.ts",
    "example:livekit-good": "tsx examples/livekit-agent.ts",
    "example:livekit-buggy": "tsx examples/livekit-agent.ts --buggy",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.18.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@livekit/rtc-node": "^1.1.0",
    "livekit-server-sdk": "^2.19.1"
  },
  "peerDependenciesMeta": {
    "@livekit/rtc-node": {
      "optional": true
    },
    "livekit-server-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@livekit/rtc-node": "^1.1.0",
    "@types/node": "^18.19.68",
    "@types/ws": "^8.18.1",
    "livekit-server-sdk": "^2.19.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
